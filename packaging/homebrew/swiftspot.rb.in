cask "swiftspot" do
  version "@VERSION@"
  sha256 "@MACOS_SHA256@"

  url "https://github.com/hanzpo/swiftspot/releases/download/v#{version}/swiftspot-v#{version}-macos-universal.dmg"
  name "SwiftSpot"
  desc "Native Spotify client"
  homepage "https://spotifast.rocks"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "SwiftSpot.app"

  zap trash: [
    "~/Library/Application Support/com.hanzpo.swiftspot",
    "~/Library/Caches/com.hanzpo.swiftspot",
  ]
end
